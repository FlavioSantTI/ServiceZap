# Variáveis de Produção do ServiceZap (.env.production)

# Appwrite Cloud / Self-Hosted
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=seu_project_id_aqui
APPWRITE_API_KEY=sua_api_key_admin_aqui

# Banco de Dados & Coleções
APPWRITE_DATABASE_ID=servicezap_db
NEXT_PUBLIC_APPWRITE_DATABASE_ID=servicezap_db
APPWRITE_COLLECTION_TENANTS=tenants
APPWRITE_COLLECTION_SERVICES=services
APPWRITE_COLLECTION_CLIENTS=clients
APPWRITE_COLLECTION_INVOICES=invoices
APPWRITE_COLLECTION_USERS=users
APPWRITE_COLLECTION_WHATSAPP=whatsapp_instances
APPWRITE_MESSAGES_COLLECTION_ID=messages
NEXT_PUBLIC_APPWRITE_MESSAGES_COLLECTION_ID=messages

# Senha do Super Admin Master (Painel /super-admin)
SUPERADMIN_PASSWORD=sua_senha_master_aqui

# Node Environment
NODE_ENV=production
